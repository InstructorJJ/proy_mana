# ============================================================
#  .env.example — Plantilla de variables de entorno
#
#  INSTRUCCIONES:
#  1. Copia este archivo como .env  (nunca subas .env a GitHub)
#  2. Completa cada variable con tus valores reales
#  3. En Railway configura estas mismas variables en
#     el panel de Variables de entorno
# ============================================================

# ── PROVEEDOR LLM ─────────────────────────────────────────
LLM_PROVIDER=groq

# ── GROQ (requerido si LLM_PROVIDER=groq) ────────────────
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_TU_CLAVE_AQUI
# Opciones vigentes: openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b
# Modelo usado SOLO para salida estructurada (nodo "reporte")
GROQ_MODEL_ESTRUCTURADO=openai/gpt-oss-120b

# ── OLLAMA (solo para desarrollo local) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── IDENTIDAD DEL AGENTE ──────────────────────────────────
AGENT_NAME=Agente el Mana
AGENT_ROLE=asistente de atención al cliente y empleados de Industria de Alimentos el Mana
TEMPERATURE=0.7
MAX_TOKENS=2048

# ── APIs EXTERNAS ─────────────────────────────────────────
OPENWEATHER_API_KEY=TU_CLAVE_OPENWEATHER_AQUI
CIUDAD_DEFAULT=Bogota

# ── MEMORIA (Sesión 3) ─────────────────────────────────────
# buffer = recuerda toda la conversación | window = solo los últimos N mensajes
MEMORY_TYPE=buffer
MEMORY_WINDOW_SIZE=8

# ── RAG / VENTANA DE CONTEXTO (Sesión 4) ───────────────────
# Carpeta con los documentos internos (PDFs + CSV) que lee el RAG
DOCUMENTOS_DIR=data/documentos
# Tamaño de cada fragmento de texto, en caracteres
TAMANO_FRAGMENTO=900
# Cuánto se repite entre un fragmento y el siguiente
SUPERPOSICION_FRAGMENTO=120
# Cuántos fragmentos relevantes se le pasan al modelo por pregunta
K_FRAGMENTOS=4

# ── PDFs usados como base de conocimiento del sub-grafo multiagente ──
PDF_KB_EMPRESA_1=01_politica_comercial.pdf
PDF_KB_EMPRESA_2=04_plan_estrategico.pdf
PDF_KB_PRODUCTOS=05_catalogo_productos.pdf

# ── FASTAPI ───────────────────────────────────────────────
# Railway asigna $PORT automáticamente — no cambies esto
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False