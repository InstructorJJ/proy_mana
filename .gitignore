# ============================================================
#  .gitignore — Archivos que NO se suben a GitHub
#
#  CRÍTICO: el .env NUNCA debe subirse al repositorio
#  porque contiene claves de API que son secretas.
# ============================================================

# Variables de entorno — NUNCA subir al repositorio
.env
.env.local
.env.production

# Entornos virtuales Python
venv/
env/
.venv/

# Caché de Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribución y empaquetado
dist/
build/
*.egg-info/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Railway
.railway/
